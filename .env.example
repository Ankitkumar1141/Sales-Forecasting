# ===========================================================
# .env.example — Copy this file to secrets.env and fill in
# your credentials. NEVER commit secrets.env to git.
# ===========================================================

# --- PostgreSQL Database ---
# Free hosting options: Supabase (supabase.com), Neon (neon.tech), Railway (railway.app)
PG_HOST=YOUR_POSTGRES_HOST          # e.g. db.xxxxxx.supabase.co
PG_PORT=5432
PG_DATABASE=store_sales
PG_USER=YOUR_POSTGRES_USERNAME
PG_PASSWORD=YOUR_POSTGRES_PASSWORD

# --- DockerHub ---
DOCKER_USERNAME=YOUR_DOCKERHUB_USERNAME
DOCKER_PASSWORD=YOUR_DOCKERHUB_ACCESS_TOKEN

# --- Render Cloud ---
RENDER_DEPLOY_WEBHOOK_URL=https://api.render.com/deploy/srv-XXXXXXXXXXXXXX?key=XXXXXXXXXXXX

# --- DVC Remote Storage (optional, if using remote) ---
# DVC_REMOTE_URL=s3://your-bucket/path
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
